{
  "name": "flowtranslate-frontend",
  "private": true,
  "version": "0.6.2",
  "type": "module",
  "scripts": {
    "ui:lab": "vite --host 127.0.0.1 --port 5174 --strictPort --open /lab.html",
    "ui:check": "playwright test --config playwright.visual.config.ts",
    "ui:reference": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "ui:native": "powershell -NoProfile -File scripts/test-native-ui.ps1",
    "ui:motion": "node scripts/capture-ui-preview.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "lint": "biome ci",
    "format": "biome format --write",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/cli": "2.11.4",
    "@vitejs/plugin-react": "6.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.43.0",
    "motion": "13.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "jsdom": "26.1.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
