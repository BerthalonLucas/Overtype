# GPU indices as reported by nvidia-smi. Prefer persistent GPU UUIDs on a server.
FAST_GPU=1
QUALITY_GPU=0
FAST_PORT=8001
QUALITY_PORT=8002
# Conservative starting reservation, to tune only after measurement.
FAST_GPU_MEMORY=0.45
QUALITY_GPU_MEMORY=0.80

# General profile (Gemma 4), GPU 0 by default like Quality.
GENERAL_GPU=0
GENERAL_PORT=8003
GENERAL_GPU_MEMORY=0.85
