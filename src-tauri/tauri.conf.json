{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Overtype",
  "version": "0.6.2",
  "identifier": "com.flowtranslate.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "create": false,
        "focus": false,
        "title": "Overtype",
        "url": "/?window=overlay",
        "width": 280,
        "height": 160,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true
      },
      {
        "label": "halo",
        "create": false,
        "focus": false,
        "focusable": false,
        "title": "Overtype",
        "url": "/?window=halo",
        "width": 64,
        "height": 32,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true
      },
      {
        "label": "settings",
        "create": false,
        "title": "Overtype Settings",
        "url": "/?window=settings",
        "width": 860,
        "height": 600,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzRDlCMjcyQjNGNEJFRUIKUldUcnZ2U3pjckxadzUyWTBBa1pYRkVxMjZDbFBzUGZrYmZCMGFSRzZZK09YV3BWUjk1VEQrUWcK",
      "endpoints": [
        "https://github.com/BerthalonLucas/Overtype/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Overtype",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
